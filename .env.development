# Development Environment Configuration
# RoofER Training System

# Fast Refresh and Hot Reload
FAST_REFRESH=true
WDS_SOCKET_HOST=localhost
WDS_SOCKET_PORT=3000
WDS_SOCKET_PATH=/ws

# Development optimizations
GENERATE_SOURCEMAP=true
REACT_APP_NODE_ENV=development

# Performance monitoring
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# Development features
REACT_APP_ENABLE_DEVTOOLS=true
REACT_APP_ENABLE_DEBUG_MODE=true

# API Configuration (Development)
REACT_APP_API_BASE_URL=http://localhost:3001
REACT_APP_ENABLE_MOCK_API=true

# Agnes AI Development Configuration
REACT_APP_AGNES_DEBUG_MODE=true
REACT_APP_ENABLE_TRAINING_LOGS=true

# Feature Flags for Development
REACT_APP_ENABLE_EXPERIMENTAL_FEATURES=true
REACT_APP_ENABLE_A11Y_DEBUG=true