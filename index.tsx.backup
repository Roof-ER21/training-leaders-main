    { id: 'm3-deductible-explain', role: 'homeowner', prompt: 'How much will this cost me up front?', expectedKeyPoints: ['Typically only the deductible if claim approved', 'No obligation inspection', 'Policy designed for storm events'], rubric: { keywords: ['deductible', 'policy', 'approved', 'no obligation'], passThreshold: 70 }, followUps: ['Would you like me to show a simple cost breakdown after approval?'], difficulty: 'beginner' },

