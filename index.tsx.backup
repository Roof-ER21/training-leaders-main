                  <div class="voice-animation">
                    <span class="voice-pulse"></span>
                    <span class="voice-pulse"></span>
                    <span class="voice-pulse"></span>
                  </div>
                  <p class="voice-text">Listening... Speak now</p>
                  <button type="button" class="btn btn-sm btn-stop-recording" data-action="stop-voice">
                    Stop Recording
                  </button>
                </div>
              </div>
            </article>
          </div>

          <div class="scenario-bottom-actions">
            <button type="button" class="btn btn-link btn-end" data-action="end-scenario">
              End Scenario
            </button>
          </div>
        </section>

        <!-- SCREEN 3: FEEDBACK SCREEN -->
