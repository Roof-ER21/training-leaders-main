    { id: 'm4-other-quotes', role: 'homeowner', prompt: 'We want to get a few other quotes first.', expectedKeyPoints: ['Acknowledge diligence', 'Insurance claim ≠ retail bidding', 'Evidence-driven approval', 'Offer inspection first'], rubric: { keywords: ['acknowledge', 'not retail', 'evidence', 'inspection'], passThreshold: 70 }, followUps: ['Would a quick inspection and photo report help you compare apples to apples?'], difficulty: 'intermediate' },
    { id: 'm4-dog-barking', role: 'homeowner', prompt: 'The dog is going crazy—can you just leave info?', expectedKeyPoints: ['Empathize', 'Offer quick 10-sec value statement', 'Set short follow-up time window', 'Confirm via text'], rubric: { keywords: ['empathize', '10 seconds', 'follow-up', 'text'], passThreshold: 70 }, followUps: ['I'll text you—does tomorrow at 10:30am or 6:15pm work better?'], difficulty: 'beginner' },
    { id: 'm4-expensive', role: 'homeowner', prompt: "This seems expensive. We can't afford it.", expectedKeyPoints: ['Empathy', 'Deductible focus', 'Insurance covers replacement', 'Offer times'], rubric: { keywords: ['understand', 'deductible', 'insurance', 'schedule'], passThreshold: 70 }, followUps: ['Would 5pm today or 10am tomorrow work to take a quick look?'], difficulty: 'beginner' },
    { id: 'm4-no-leaks', role: 'homeowner', prompt: "We don't have any leaks—so there's no problem, right?", expectedKeyPoints: ['Acknowledge', 'Explain hidden roof-level damage vs. leaks', 'Insurance requires evidence not active leak', 'Offer quick roof-level check'], rubric: { keywords: ['acknowledge', 'roof-level', 'evidence', 'check'], passThreshold: 70 }, followUps: ['Would 10 minutes on the roof for photos help you decide?'], difficulty: 'intermediate' },
    { id: 'm4-wait-spring', role: 'homeowner', prompt: 'Let's wait until spring—weather will be better.', expectedKeyPoints: ['Empathize about timing', 'Explain claim windows/system aging', 'Document now, schedule later if needed', 'Offer short inspection window'], rubric: { keywords: ['empathize', 'window', 'document', 'schedule'], passThreshold: 70 }, followUps: ['Would you like a documented baseline now and decide on timing later?'], difficulty: 'intermediate' },
    { id: 'm4-hoa-restrictions', role: 'homeowner', prompt: 'Our HOA is strict—this probably isn't allowed.', expectedKeyPoints: ['Acknowledge HOA concern', 'Clarify inspection/photo documentation allowed', 'Work with HOA on materials/colors post-approval', 'Next step: simple inspection first'], rubric: { keywords: ['HOA', 'allowed', 'materials', 'colors', 'next step'], passThreshold: 70 }, followUps: ['If it qualifies, we coordinate approvals; want a quick check now?'], difficulty: 'intermediate' },
    { id: 'm4-trust-proof', role: 'homeowner', prompt: 'How do I know you're legit? We've had a lot of people knocking.', expectedKeyPoints: ['Empathize with flood of contractors', 'Local presence and references', 'Photo-report transparency', 'No-obligation check with clear next step'], rubric: { keywords: ['local', 'references', 'transparency', 'no obligation', 'next step'], passThreshold: 70 }, followUps: ['Would you like to see a sample photo report from nearby?'], difficulty: 'intermediate' },
    { id: 'm4-too-busy', role: 'homeowner', prompt: 'Today is crazy—come back later sometime.', expectedKeyPoints: ['Acknowledge', 'Offer two specific times', '15-minute check promise', 'Set reminder/confirm'], rubric: { keywords: ['acknowledge', 'two times', '15 minutes', 'confirm'], passThreshold: 70 }, followUps: ['Do you prefer after work today or tomorrow morning?'], difficulty: 'beginner' },
    { id: 'm4-cannot-afford-deductible', role: 'homeowner', prompt: 'We can't afford the deductible right now.', expectedKeyPoints: ['Empathize', 'Only pay if approved', 'Timing aligns with completion', 'No-obligation inspection'], rubric: { keywords: ['empathize', 'approved', 'completion', 'no obligation'], passThreshold: 70 }, followUps: ['Would it help if I showed the timeline of payments?'], difficulty: 'beginner' },

    // Module 5 - Insurance & Scope
    { id: 'm5-rcv-acv', role: 'homeowner', prompt: 'Why do they withhold depreciation? When do I pay the deductible?', expectedKeyPoints: ['Depreciation release after completion', 'Deductible is out-of-pocket', 'Two-payment flow'], rubric: { keywords: ['depreciation', 'completion', 'deductible', 'two payments'], passThreshold: 70 }, followUps: ['Would you like to see a quick calculator demo that shows your numbers?'], difficulty: 'intermediate' },

    // Module 9 - Capstone scenarios
    { id: 'm9-why-pick-you', role: 'homeowner', prompt: "We're comparing a few companies—why should we pick you?", expectedKeyPoints: ['Local specialist', 'Insurance navigation', 'Photo documentation', 'Clear process', 'Schedule'], rubric: { keywords: ['local', 'specialize', 'insurance', 'photos', 'process', 'schedule'], passThreshold: 75 }, followUps: ['Would you like references or to see a sample Photo Report?'], difficulty: 'advanced' },
    { id: 'm9-deductible-delay', role: 'homeowner', prompt: 'We can't swing the deductible. Can we delay everything?', expectedKeyPoints: ['Empathize', 'Only due if approved and at completion', 'Plan options/timing', 'No-obligation inspection now'], rubric: { keywords: ['empathize', 'approved', 'completion', 'options'], passThreshold: 70 }, followUps: ['Would seeing a basic cost timeline help you decide?'], difficulty: 'intermediate' },

    // Adjuster scenarios
    { id: 'm2-slope-sampling', role: 'adjuster', prompt: 'Describe your slope sampling method across a multi-face roof to ensure representative findings.', expectedKeyPoints: ['Cardinal slopes when possible', 'Windward/leeward consideration', 'Similar materials/age', 'Replicate counts'], rubric: { keywords: ['sampling', 'windward', 'leeward', 'replicate', 'representative'], passThreshold: 75 }, followUps: ['How many test squares would you plan for a four-slope roof and where?'], difficulty: 'advanced' },
    { id: 'm2-collateral-priority', role: 'adjuster', prompt: 'List collateral items you prioritize to corroborate hail findings and why.', expectedKeyPoints: ['Soft metals (downspouts, gutters)', 'Screens/garage for pitting', 'A/C fins/housings', 'Fence caps/paint'], rubric: { keywords: ['soft metals', 'screens', 'garage', 'A/C', 'collateral'], passThreshold: 75 }, followUps: ['Which two collateral photos do you present first on most claims?'], difficulty: 'advanced' },
    { id: 'm5-supplement-justify', role: 'adjuster', prompt: 'Explain how you justify a supplement using photo sequences and measured quantities.', expectedKeyPoints: ['Before/after context', 'Close-ups with scale', 'Measurement math', 'Code references when applicable'], rubric: { keywords: ['before/after', 'scale', 'measure', 'code', 'supplement'], passThreshold: 75 }, followUps: ['Name two photos that are most persuasive for drip edge addition.'], difficulty: 'advanced' },
    { id: 'm9-scope-clarity', role: 'adjuster', prompt: 'Lead a scope-clarity discussion with an adjuster who is new to hail claims.', expectedKeyPoints: ['Walk order using report', 'Define criteria for hits vs wear', 'Show collateral early', 'Agree on next steps'], rubric: { keywords: ['walk order', 'criteria', 'collateral', 'next steps'], passThreshold: 80 }, followUps: ['What one-page handout would you bring for criteria clarity?'], difficulty: 'advanced' },

    // Rep practice scenarios
    { id: 'm1-elevator-pitch', role: 'rep', prompt: 'Deliver your 30-second pitch for a post-storm neighborhood.', expectedKeyPoints: ['Use name and purpose', 'Free/no-obligation inspection', 'Social proof (neighbors, local)', 'Clear next step/time options'], rubric: { keywords: ['name', 'free', 'no obligation', 'local', 'neighbors', 'schedule'], passThreshold: 70 }, followUps: ['Now shorten it to 20 seconds without losing clarity.'], difficulty: 'beginner' },
    { id: 'm2-borderline-damage', role: 'rep', prompt: 'Borderline damage scenario—what do you do?', expectedKeyPoints: ['Document thoroughly', 'Present confidently', 'Let adjuster make final determination', "Don't pre-reject valid claims"], rubric: { keywords: ['document', 'present', 'adjuster', 'final', 'sign it up'], passThreshold: 70 }, followUps: ['Which three photos would you prioritize for an adjuster to see first?'], difficulty: 'intermediate' },
    { id: 'm3-adjuster-meeting-prep', role: 'rep', prompt: 'Outline how you prepare and run an adjuster meeting.', expectedKeyPoints: ['Organized photo report with labels', 'Test squares/chalk ready', 'Walk order: elevations, slopes, collateral', 'Professional cooperation tone'], rubric: { keywords: ['report', 'labels', 'chalk', 'order', 'cooperate'], passThreshold: 70 }, followUps: ['What are your first two photos to present to the adjuster and why?'], difficulty: 'intermediate' },
];

// Session state
let agnesSession = {
    selectedRole: '' as 'homeowner' | 'rep' | 'adjuster' | '',
    selectedDifficulty: '' as 'beginner' | 'intermediate' | 'advanced' | '',
    currentScenarioIndex: 0,
    scenarioPool: [] as AgnesScenario[],
    sessionScores: [] as number[],
    sessionResults: [] as any[],
};

async function initRolePlay() {
    if (!ai) {
        const setup = document.getElementById('roleplay-setup');
        if (setup) {
            setup.innerHTML = '<p style="color: red;">Agnes 21 Role-Play is unavailable: missing API key. Set GEMINI_API_KEY in .env.local and reload.</p>';
        }
        return;
    }

    // Setup role selection
    const roleBtns = document.querySelectorAll('.role-btn');
    const difficultySelector = document.querySelector('.difficulty-selector') as HTMLElement;
    const sessionInfo = document.querySelector('.session-info') as HTMLElement;
    const startTrainingBtn = document.getElementById('start-training');

    roleBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            roleBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            agnesSession.selectedRole = (btn as HTMLElement).dataset.role as any;

            // Show difficulty selector
            difficultySelector.style.display = 'block';

            // Update session info
            const roleSpan = document.getElementById('selected-role');
            if (roleSpan) roleSpan.textContent = (btn as HTMLElement).dataset.desc || '';
        });
    });

    // Setup difficulty selection
    const difficultyBtns = document.querySelectorAll('.difficulty-btn');
    difficultyBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            difficultyBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            agnesSession.selectedDifficulty = (btn as HTMLElement).dataset.difficulty as any;

            // Show session info and start button
            sessionInfo.style.display = 'block';
            const diffSpan = document.getElementById('selected-difficulty');
            if (diffSpan) diffSpan.textContent = agnesSession.selectedDifficulty;
        });
    });

    // Start training button
    startTrainingBtn?.addEventListener('click', () => {
        startAgnesSession();
    });

    // Response submission
    const submitBtn = document.getElementById('submit-response');
    submitBtn?.addEventListener('click', () => {
        submitAgnesResponse();
    });

    // Voice input
    const voiceBtn = document.getElementById('voice-btn');
    voiceBtn?.addEventListener('click', () => {
        startVoiceInput();
    });

    // Hint button
    const hintBtn = document.getElementById('hint-btn');
    hintBtn?.addEventListener('click', () => {
        showAgnesHint();
    });

    // Next scenario
    const nextBtn = document.getElementById('next-scenario');
    nextBtn?.addEventListener('click', () => {
        loadNextScenario();
    });

    // Retry scenario
    const retryBtn = document.getElementById('retry-scenario');
    retryBtn?.addEventListener('click', () => {
        retryCurrentScenario();
    });

    // View summary
    const summaryBtn = document.getElementById('view-summary');
    summaryBtn?.addEventListener('click', () => {
        showSessionSummary();
    });

    // New session
    const newSessionBtn = document.getElementById('new-session');
    newSessionBtn?.addEventListener('click', () => {
        resetAgnesSession();
    });

    // Back to training
    const backBtn = document.getElementById('back-to-training');
    backBtn?.addEventListener('click', () => {
        hideSessionSummary();
    });
}

function startAgnesSession() {
    // Filter scenarios by selected role and difficulty
    agnesSession.scenarioPool = AGNES_SCENARIOS.filter(s => {
        const roleMatch = s.role === agnesSession.selectedRole;
        const difficultyMatch = !agnesSession.selectedDifficulty ||
                               !s.difficulty ||
                               s.difficulty === agnesSession.selectedDifficulty ||
                               (agnesSession.selectedDifficulty === 'intermediate' && (s.difficulty === 'beginner' || s.difficulty === 'intermediate')) ||
                               (agnesSession.selectedDifficulty === 'advanced');
        return roleMatch && difficultyMatch;
    });

    // Shuffle scenarios
    agnesSession.scenarioPool.sort(() => Math.random() - 0.5);

    agnesSession.currentScenarioIndex = 0;
    agnesSession.sessionScores = [];
    agnesSession.sessionResults = [];

    // Hide setup, show scenario display
    const setup = document.getElementById('roleplay-setup');
    const display = document.getElementById('scenario-display');
    if (setup) setup.style.display = 'none';
    if (display) display.style.display = 'block';

    loadCurrentScenario();
}

function loadCurrentScenario() {
    const scenario = agnesSession.scenarioPool[agnesSession.currentScenarioIndex];
    if (!scenario) {
        showSessionSummary();
        return;
    }

    // Update UI
    const titleEl = document.getElementById('scenario-title');
    const numberEl = document.getElementById('scenario-number');
    const difficultyEl = document.getElementById('scenario-difficulty');
    const roleEl = document.getElementById('scenario-role');
    const contextEl = document.getElementById('scenario-context');
    const promptEl = document.getElementById('agnes-prompt');
    const responseArea = document.querySelector('.response-area') as HTMLElement;
    const feedbackArea = document.getElementById('feedback-area');

    if (titleEl) titleEl.textContent = `Scenario ${agnesSession.currentScenarioIndex + 1}`;
    if (numberEl) numberEl.textContent = `${agnesSession.currentScenarioIndex + 1} of ${agnesSession.scenarioPool.length}`;
    if (difficultyEl) difficultyEl.textContent = scenario.difficulty || 'intermediate';
    if (roleEl) roleEl.textContent = `Role: ${scenario.role}`;

    if (contextEl) {
        contextEl.innerHTML = `<p><strong>Context:</strong> You are practicing as a ${agnesSession.selectedRole === 'homeowner' ? 'Sales Rep responding to a homeowner' : agnesSession.selectedRole === 'adjuster' ? 'Sales Rep negotiating with an insurance adjuster' : 'Homeowner interacting with a sales rep'}.</p>`;
    }

    if (promptEl) {
        promptEl.innerHTML = `<div class="prompt-box"><strong>${scenario.role === 'homeowner' ? 'Homeowner says:' : scenario.role === 'adjuster' ? 'Adjuster asks:' : 'Challenge:'}</strong><p>"${scenario.prompt}"</p></div>`;
    }

    // Clear response and hide feedback
    const responseInput = document.getElementById('user-response') as HTMLTextAreaElement;
    if (responseInput) responseInput.value = '';
    if (responseArea) responseArea.style.display = 'block';
    if (feedbackArea) feedbackArea.style.display = 'none';
}

async function submitAgnesResponse() {
    const responseInput = document.getElementById('user-response') as HTMLTextAreaElement;
    const response = responseInput?.value.trim();

    if (!response) {
        alert('Please type a response before submitting.');
        return;
    }

    const scenario = agnesSession.scenarioPool[agnesSession.currentScenarioIndex];

    // Calculate score
    const scoringResult = scoreAgnesResponse(response, scenario);

    // Generate AI feedback for strengths and improvements
    const aiFeedback = await generateAIFeedback(response, scenario, scoringResult);

    // Store result
    agnesSession.sessionScores.push(scoringResult.score);
    agnesSession.sessionResults.push({
        scenario: scenario.prompt,
        response,
        score: scoringResult.score,
        matched: scoringResult.matchedPoints,
        missed: scoringResult.missedPoints,
        strengths: aiFeedback.strengths,
        improvements: aiFeedback.improvements,
    });

    // Display feedback
    displayFeedback(scoringResult, aiFeedback);
}

function scoreAgnesResponse(response: string, scenario: AgnesScenario): {
    score: number;
    matchedPoints: string[];
    missedPoints: string[];
    keywordMatches: string[];
} {
    const responseLower = response.toLowerCase();

    // Key point matching (70% weight)
    const matchedPoints: string[] = [];
    const missedPoints: string[] = [];

    scenario.expectedKeyPoints.forEach(point => {
        // Simple keyword matching - check if response contains key concepts
        const pointWords = point.toLowerCase().split(/\s+/).filter(w => w.length > 3);
        const hasMatch = pointWords.some(word => responseLower.includes(word));

        if (hasMatch) {
            matchedPoints.push(point);
        } else {
            missedPoints.push(point);
        }
    });

    const keyPointScore = scenario.expectedKeyPoints.length > 0
        ? (matchedPoints.length / scenario.expectedKeyPoints.length) * 70
        : 0;

    // Rubric keyword matching (30% weight)
    const keywordMatches: string[] = [];
    scenario.rubric.keywords.forEach(keyword => {
        if (responseLower.includes(keyword.toLowerCase())) {
            keywordMatches.push(keyword);
        }
    });

    const keywordScore = scenario.rubric.keywords.length > 0
        ? (keywordMatches.length / scenario.rubric.keywords.length) * 30
        : 0;

    const totalScore = Math.round(keyPointScore + keywordScore);

    return {
        score: totalScore,
        matchedPoints,
        missedPoints,
        keywordMatches,
    };
}

async function generateAIFeedback(response: string, scenario: AgnesScenario, scoringResult: any): Promise<{
    strengths: string[];
    improvements: string[];
}> {
    if (!ai) {
        return {
            strengths: ['Response submitted'],
            improvements: ['Enable AI for detailed feedback'],
        };
    }

    try {
        const prompt = `You are Agnes, a roofing sales training coach. Analyze this trainee's response to a ${scenario.role} scenario.

Scenario: "${scenario.prompt}"
Expected key points: ${scenario.expectedKeyPoints.join(', ')}
Trainee's response: "${response}"

Score: ${scoringResult.score}/100
Matched points: ${scoringResult.matchedPoints.join(', ') || 'none'}
Missed points: ${scoringResult.missedPoints.join(', ') || 'none'}

Provide:
1. Two specific strengths in the response (what they did well)
2. Two specific improvements (what to add or refine)

Keep each point to one concise sentence. Be encouraging but honest.`;

        const result = await ai.models.generateContent({
            model: 'gemini-2.5-flash',
            contents: prompt,
        });

        const text = result.text.trim();

        // Parse strengths and improvements from response
        const strengthsMatch = text.match(/strengths?:?\s*([\s\S]*?)(?=improvements?:?|$)/i);
        const improvementsMatch = text.match(/improvements?:?\s*([\s\S]*?)$/i);

        const strengths = strengthsMatch
            ? strengthsMatch[1].trim().split('\n').filter(s => s.trim()).slice(0, 2)
            : ['Good effort on this scenario'];

        const improvements = improvementsMatch
            ? improvementsMatch[1].trim().split('\n').filter(s => s.trim()).slice(0, 2)
            : ['Review the key points for this scenario'];

        return { strengths, improvements };
    } catch (error) {
        console.error('AI feedback generation failed:', error);
        return {
            strengths: ['Response demonstrates understanding'],
            improvements: ['Review missed key points listed above'],
        };
    }
}

function displayFeedback(scoringResult: any, aiFeedback: any) {
    const responseArea = document.querySelector('.response-area') as HTMLElement;
    const feedbackArea = document.getElementById('feedback-area');

    if (responseArea) responseArea.style.display = 'none';
    if (feedbackArea) feedbackArea.style.display = 'block';

    // Score circle
    const scoreCircle = document.getElementById('score-circle');
    const scoreDetails = document.getElementById('score-details');

    if (scoreCircle) {
        const scoreClass = scoringResult.score >= 80 ? 'excellent' : scoringResult.score >= 70 ? 'good' : scoringResult.score >= 50 ? 'fair' : 'needs-work';
        scoreCircle.innerHTML = `<div class="score ${scoreClass}">${scoringResult.score}</div>`;
    }

    if (scoreDetails) {
        const passThreshold = agnesSession.scenarioPool[agnesSession.currentScenarioIndex].rubric.passThreshold || 70;
        const passed = scoringResult.score >= passThreshold;
        scoreDetails.innerHTML = `
            <p><strong>Score:</strong> ${scoringResult.score}/100</p>
            <p><strong>Status:</strong> ${passed ? '✅ Passed' : '❌ Below threshold (' + passThreshold + ')'}</p>
            <p><strong>Key Points Hit:</strong> ${scoringResult.matchedPoints.length}/${scoringResult.matchedPoints.length + scoringResult.missedPoints.length}</p>
        `;
    }

    // Matched points
    const matchedList = document.getElementById('matched-points');
    if (matchedList) {
        matchedList.innerHTML = scoringResult.matchedPoints.length > 0
            ? scoringResult.matchedPoints.map((p: string) => `<li>${p}</li>`).join('')
            : '<li><em>None detected</em></li>';
    }

    // Missed points
    const missedList = document.getElementById('missed-points');
    if (missedList) {
        missedList.innerHTML = scoringResult.missedPoints.length > 0
            ? scoringResult.missedPoints.map((p: string) => `<li>${p}</li>`).join('')
            : '<li><em>All key points covered!</em></li>';
    }

    // Strengths
    const strengthsList = document.getElementById('strengths-list');
    if (strengthsList) {
        strengthsList.innerHTML = aiFeedback.strengths.map((s: string) => `<li>${s}</li>`).join('');
    }

    // Improvements
    const improvementsList = document.getElementById('improvements-list');
    if (improvementsList) {
        improvementsList.innerHTML = aiFeedback.improvements.map((i: string) => `<li>${i}</li>`).join('');
    }
}

function loadNextScenario() {
    agnesSession.currentScenarioIndex++;

    if (agnesSession.currentScenarioIndex >= agnesSession.scenarioPool.length) {
        showSessionSummary();
    } else {
        loadCurrentScenario();
    }
}

function retryCurrentScenario() {
    const responseArea = document.querySelector('.response-area') as HTMLElement;
    const feedbackArea = document.getElementById('feedback-area');
    const responseInput = document.getElementById('user-response') as HTMLTextAreaElement;

    if (responseArea) responseArea.style.display = 'block';
    if (feedbackArea) feedbackArea.style.display = 'none';
    if (responseInput) responseInput.value = '';
}

function showAgnesHint() {
    const scenario = agnesSession.scenarioPool[agnesSession.currentScenarioIndex];
    const hint = scenario.expectedKeyPoints[Math.floor(Math.random() * scenario.expectedKeyPoints.length)];
    alert(`💡 Hint: Make sure to address this point: "${hint}"`);
}

function startVoiceInput() {
    if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
        alert('Voice input is not supported in your browser. Please type your response.');
        return;
    }

    const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    const recognition = new SpeechRecognition();

    recognition.continuous = false;
    recognition.interimResults = false;

    recognition.onstart = () => {
        const voiceBtn = document.getElementById('voice-btn');
        if (voiceBtn) voiceBtn.textContent = '🎙️';
    };

    recognition.onresult = (event: any) => {
        const transcript = event.results[0][0].transcript;
        const responseInput = document.getElementById('user-response') as HTMLTextAreaElement;
        if (responseInput) {
            responseInput.value = transcript;
        }
    };

    recognition.onerror = (event: any) => {
        console.error('Speech recognition error:', event.error);
        alert('Voice input failed. Please try again or type your response.');
    };

    recognition.onend = () => {
        const voiceBtn = document.getElementById('voice-btn');
        if (voiceBtn) voiceBtn.textContent = '🎤';
    };

    recognition.start();
}

function showSessionSummary() {
    const scenarioDisplay = document.getElementById('scenario-display');
    const sessionSummary = document.getElementById('session-summary');
    const summaryContent = document.getElementById('summary-content');

    if (scenarioDisplay) scenarioDisplay.style.display = 'none';
    if (sessionSummary) sessionSummary.style.display = 'block';

    // Calculate statistics
    const avgScore = agnesSession.sessionScores.length > 0
        ? Math.round(agnesSession.sessionScores.reduce((a, b) => a + b, 0) / agnesSession.sessionScores.length)
        : 0;

    const highScore = Math.max(...agnesSession.sessionScores, 0);
    const lowScore = Math.min(...agnesSession.sessionScores, 100);

    if (summaryContent) {
        summaryContent.innerHTML = `
            <div class="summary-stats">
                <h4>Session Statistics</h4>
                <p><strong>Scenarios Completed:</strong> ${agnesSession.sessionScores.length}</p>
                <p><strong>Average Score:</strong> ${avgScore}/100</p>
                <p><strong>Highest Score:</strong> ${highScore}/100</p>
                <p><strong>Lowest Score:</strong> ${lowScore}/100</p>
            </div>

            <div class="summary-results">
                <h4>Detailed Results</h4>
                ${agnesSession.sessionResults.map((result, idx) => `
                    <div class="result-item">
                        <h5>Scenario ${idx + 1}: ${result.score}/100</h5>
                        <p><strong>Prompt:</strong> "${result.scenario}"</p>
                        <p><strong>Your response:</strong> "${result.response.substring(0, 150)}${result.response.length > 150 ? '...' : ''}"</p>
                        <p><strong>Matched:</strong> ${result.matched.length} key points</p>
                        <p><strong>Missed:</strong> ${result.missed.length} key points</p>
                    </div>
                `).join('')}
            </div>

            <div class="summary-recommendations">
                <h4>📚 Next Steps</h4>
                <ul>
                    <li>Review scenarios where you scored below 70</li>
                    <li>Practice the missed key points</li>
                    <li>Try a higher difficulty level</li>
                    <li>Focus on ${agnesSession.selectedRole} role mastery</li>
                </ul>
            </div>
        `;
    }
}

function hideSessionSummary() {
    const scenarioDisplay = document.getElementById('scenario-display');
    const sessionSummary = document.getElementById('session-summary');

    if (scenarioDisplay) scenarioDisplay.style.display = 'block';
    if (sessionSummary) sessionSummary.style.display = 'none';
}

function resetAgnesSession() {
    const setup = document.getElementById('roleplay-setup');
    const display = document.getElementById('scenario-display');
    const summary = document.getElementById('session-summary');
    const difficultySelector = document.querySelector('.difficulty-selector') as HTMLElement;
    const sessionInfo = document.querySelector('.session-info') as HTMLElement;

    if (setup) setup.style.display = 'block';
    if (display) display.style.display = 'none';
    if (summary) summary.style.display = 'none';
    if (difficultySelector) difficultySelector.style.display = 'none';
    if (sessionInfo) sessionInfo.style.display = 'none';

    // Reset all buttons
    document.querySelectorAll('.role-btn, .difficulty-btn').forEach(btn => btn.classList.remove('active'));

    // Reset session state
    agnesSession = {
        selectedRole: '',
        selectedDifficulty: '',
        currentScenarioIndex: 0,
        scenarioPool: [],
        sessionScores: [],
        sessionResults: [],
    };
}


// --- Quiz Generation and Handling ---
interface QuizQuestion {
  question: string;
  options: string[];
  answer: string;
}

async function generateQuiz() {
  const quizArea = document.getElementById('quiz-area');
  if (!quizArea) return;

  quizArea.innerHTML = '<div id="loader">Generating your quiz...</div>';

  try {
    if (!ai) {
      quizArea.innerHTML = '<p style="color: red;">Quiz is unavailable: missing API key. Set GEMINI_API_KEY in .env.local and reload.</p>';
      return;
    }
     const trainingSummary = Object.values(trainingContent).join(' '); // Use all content

    const result = await ai.models.generateContent({
        model: 'gemini-2.5-flash',
        contents: `Based on this summary of the Roof-ER sales training, generate a 5-question multiple-choice quiz. Ensure the "answer" field exactly matches one of the strings in the "options" array. ${trainingSummary}`,
        config: {
            responseMimeType: "application/json",
            responseSchema: {
                type: Type.ARRAY,
                items: {
                  type: Type.OBJECT,
                  properties: {
                    question: { type: Type.STRING },
                    options: {
                      type: Type.ARRAY,
                      items: { type: Type.STRING }
                    },
                    answer: { type: Type.STRING }
                  },
                  required: ["question", "options", "answer"]
                }
            }
        }
    });

    const quizData: QuizQuestion[] = JSON.parse(result.text.trim());
    renderQuiz(quizData);
  } catch (error) {
    console.error("Quiz generation failed:", error);
    quizArea.innerHTML = '<p style="color: red;">Sorry, there was an error generating the quiz. Please try again.</p>';
  }
}

function renderQuiz(quizData: QuizQuestion[]) {
  const quizArea = document.getElementById('quiz-area');
  if (!quizArea) return;

  quizArea.innerHTML = quizData.map((q, index) => `
    <div class="quiz-item" data-question-index="${index}">
      <p class="quiz-question">${index + 1}. ${q.question}</p>
      <ul class="quiz-options">
        ${q.options.map(option => `<li data-option="${option.replace(/"/g, '&quot;')}">${option}</li>`).join('')}
      </ul>
      <div id="quiz-feedback-${index}" class="quiz-feedback"></div>
    </div>
  `).join('') + '<button id="submitQuizButton">Submit Answers</button>';

  const options = quizArea.querySelectorAll('.quiz-options li');
  options.forEach(option => {
    option.addEventListener('click', () => {
        const parentOptions = option.parentElement as HTMLElement;
        parentOptions.querySelectorAll('li').forEach(li => li.classList.remove('selected'));
        option.classList.add('selected');
    });
  });

  const submitButton = document.getElementById('submitQuizButton');
  submitButton?.addEventListener('click', () => {
    quizData.forEach((q, index) => {
        const selectedOption = document.querySelector(`.quiz-item[data-question-index="${index}"] .quiz-options li.selected`) as HTMLElement;
        const feedbackEl = document.getElementById(`quiz-feedback-${index}`);
        if(selectedOption && feedbackEl) {
            const userAnswer = selectedOption.dataset.option;
            if(userAnswer === q.answer) {
                feedbackEl.textContent = 'Correct!';
                feedbackEl.className = 'quiz-feedback correct';
            } else {
                feedbackEl.textContent = `Incorrect. The correct answer is: ${q.answer}`;
                feedbackEl.className = 'quiz-feedback incorrect';
            }
        }
    });
    (submitButton as HTMLButtonElement).disabled = true;
  });
}

// --- Module Navigation ---

function renderModule(moduleName: string) {
  if (!mainContent) return;
  mainContent.innerHTML = trainingContent[moduleName] || '<div>Content not found.</div>';
  
  // Cancel any ongoing speech when changing modules
  if (synth.speaking) {
      synth.cancel();
      currentUtterance = null;
  }

  // Initialize interactive elements for specific modules
  switch (moduleName) {
      case 'quiz':
          document.getElementById('generateQuizButton')?.addEventListener('click', generateQuiz);
          break;
      case 'sales-cycle':
          initSalesCycleSorter();
          break;
      case 'objection-handling':
          initObjectionMatcher();
          break;
      case 'role-play':
          initRolePlay();
          break;
      case 'welcome':
          initQuickQuiz1();
          initWelcomeModals();
          break;
      // New module initializers
      case 'general-knowledge':
          initQuickQuiz2();
          break;
      case 'final-exam':
          initFinalExam();
          break;
      case 'handling-initial-pitch-objections':
          initObjectionMatcher();
          break;
      case 'sales-cycle-job-flow':
          initSalesCycleSorter();
          break;
      case 'commitment':
          initCommitmentGate();
          break;
  }
}

function handleNavigation(event: Event) {
  const target = event.target as HTMLElement;
  if (target.tagName === 'LI' && target.dataset.module) {
    const moduleName = target.dataset.module;

    // Gate: require commitment signing to proceed beyond core modules
    // DISABLED: Allow access to all modules without commitment signature
    // const requiresCommitment = !['welcome','commitment'].includes(moduleName);
    // const signed = localStorage.getItem(STORAGE_KEYS.commitmentSigned) === 'true';
    // if (requiresCommitment && !signed) {
    //     alert('Please review and digitally sign the commitments before proceeding.');
    //     renderModule('commitment');
    //     sidebar?.querySelectorAll('li').forEach(li => li.classList.remove('active'));
    //     sidebar?.querySelector('li[data-module="commitment"]')?.classList.add('active');
    //     return;
    // }

    sidebar?.querySelectorAll('li').forEach(li => li.classList.remove('active'));
    target.classList.add('active');
    renderModule(moduleName);
  }
}

// --- Initial Load ---
document.addEventListener('DOMContentLoaded', () => {
  if (sidebar) {
    sidebar.addEventListener('click', handleNavigation);
  }
  mainContent?.addEventListener('click', handleSpeak);
  renderModule('welcome');
  document.querySelector('#sidebar li[data-module="welcome"]')?.classList.add('active');
});

