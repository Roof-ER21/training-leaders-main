            </article>

            <article class="role-card" data-role="rep">
              <div class="role-card-icon">🏠</div>
              <h3 class="role-card-title">Practice as Homeowner vs Rep</h3>
              <p class="role-card-description">
                You play the homeowner. Agnes simulates a sales representative. Learn to recognize effective sales techniques and homeowner concerns.
              </p>
              <ul class="role-card-skills">
                <li>Understanding homeowner perspective</li>
                <li>Recognizing sales tactics</li>
                <li>Asking qualifying questions</li>
                <li>Decision-making process</li>
              </ul>
              <button type="button" class="btn btn-primary role-select-btn" data-role-type="rep">
                Select This Role
              </button>
            </article>

            <article class="role-card" data-role="adjuster">
              <div class="role-card-icon">📋</div>
              <h3 class="role-card-title">Practice as Rep vs Adjuster</h3>
              <p class="role-card-description">
                You play the representative negotiating with an insurance adjuster. Agnes simulates various adjuster personalities and negotiation scenarios.
              </p>
              <ul class="role-card-skills">
                <li>Professional negotiation</li>
                <li>Documentation review</li>
                <li>Scope of work defense</li>
                <li>Professional communication</li>
              </ul>
              <button type="button" class="btn btn-primary role-select-btn" data-role-type="adjuster">
                Select This Role
              </button>
            </article>
          </div>
        </section>

        <!-- SCREEN 2: ACTIVE ROLE-PLAY -->
        <section id="roleplay-active-screen" class="roleplay-screen" data-screen="roleplay-active" style="display:none;">
          <div class="scenario-progress">
            <span class="scenario-count" id="scenario-count">Scenario 1</span>
            <span class="scenario-role-badge" id="active-role-badge">Rep vs Homeowner</span>
          </div>

          <header class="scenario-header">
            <h2 id="scenario-title" class="scenario-title">Loading Scenario...</h2>
            <p class="scenario-context" id="scenario-context"></p>
          </header>

          <div class="conversation-container">
            <article class="message message-agnes">
              <div class="message-avatar">Agnes</div>
              <div class="message-content">
                <div class="message-bubble">
                  <p class="message-text" id="agnes-current-message"></p>
                </div>
              </div>
            </article>

            <article class="message message-user-input">
              <div class="message-avatar">You</div>
              <div class="message-content">
                <div class="response-input-container">
                  <label for="user-response-textarea" class="sr-only">Your response to Agnes</label>
                  <textarea
                    id="user-response-textarea"
                    class="user-response-textarea"
                    placeholder="Type your response here... (or use voice input)"
                    rows="4"
                    maxlength="1000"
                  ></textarea>
                  <div class="textarea-meta">
                    <span id="response-char-count" class="char-counter">0 / 1000 characters</span>
                  </div>
                </div>

                <div class="response-actions">
                  <button type="button" class="btn btn-icon-text btn-voice" data-action="voice-input">
                    <span class="btn-text">🎤 Voice Input</span>
                  </button>
                  <button type="button" class="btn btn-secondary btn-hint" data-action="show-hint">
                    <span class="btn-text">💡 Hint</span>
                  </button>
                  <button type="button" class="btn btn-primary btn-submit" data-action="submit-response" disabled>
                    Submit Response
                  </button>
