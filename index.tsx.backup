// Get all scenarios from all modules
function getAllAgnesScenarios() {
  const allScenarios: any[] = [];
  Object.keys(agnesScenarios).forEach(moduleKey => {
    const module = (agnesScenarios as any)[moduleKey];
    module.scenarios.forEach((scenario: any) => {
      allScenarios.push({ ...scenario, module: moduleKey });
    });
  });
  return allScenarios;
}

// Get scenarios by role
function getAgnesScenariosByRole(role: string) {
  const allScenarios = getAllAgnesScenarios();
  return allScenarios.filter(scenario => scenario.role === role);
}

// ========================================
// AGNES 21 SCORING ENGINE
// ========================================

/**
 * Score a user response against expected key points and rubric keywords
 * Uses 70/30 weighted formula (70% key points, 30% keywords)
 */
function scoreResponse(
  userResponse: string,
  expectedKeyPoints: string[],
  rubricKeywords: string[],
  passThreshold: number
): {
  score: number;
  passed: boolean;
  matchedPoints: string[];
  missedPoints: string[];
  matchedKeywords: string[];
  missedKeywords: string[];
} {
  const normalizedResponse = userResponse.toLowerCase().trim();

  // Helper function to check if phrase exists in response
  const findMatch = (phrase: string, text: string): boolean => {
    const normalizedPhrase = phrase.toLowerCase().trim();
    const words = normalizedPhrase.split(/\s+/);
    return words.every(word => {
      const wordRegex = new RegExp(`\\b${word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i');
      return wordRegex.test(text);
    });
  };

  // Calculate key points score (70% weight)
  const matchedPoints = expectedKeyPoints.filter(point => findMatch(point, normalizedResponse));
  const missedPoints = expectedKeyPoints.filter(point => !findMatch(point, normalizedResponse));
  const keyPointsScore = expectedKeyPoints.length > 0 ? (matchedPoints.length / expectedKeyPoints.length) * 100 : 100;

  // Calculate rubric keywords score (30% weight)
  const matchedKeywords = rubricKeywords.filter(keyword => findMatch(keyword, normalizedResponse));
  const missedKeywords = rubricKeywords.filter(keyword => !findMatch(keyword, normalizedResponse));
  const keywordsScore = rubricKeywords.length > 0 ? (matchedKeywords.length / rubricKeywords.length) * 100 : 100;

  // Final score (70/30 weighted)
  const finalScore = Math.round((keyPointsScore * 0.7) + (keywordsScore * 0.3));
  const passed = finalScore >= passThreshold;

  return {
    score: finalScore,
    passed,
    matchedPoints,
    missedPoints,
    matchedKeywords,
    missedKeywords
  };
}

