                <aside id="hint-box" class="hint-box hidden">
                  <header class="hint-header">
                    <h4 class="hint-title">💡 Helpful Hint</h4>
                    <button type="button" class="btn-icon btn-close-hint" data-action="close-hint">✕</button>
