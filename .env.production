# Production Environment Configuration
# RoofER Training System

# Production optimizations
GENERATE_SOURCEMAP=false
REACT_APP_NODE_ENV=production

# Performance monitoring
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# Production features
REACT_APP_ENABLE_DEVTOOLS=false
REACT_APP_ENABLE_DEBUG_MODE=false

# API Configuration (Production)
REACT_APP_API_BASE_URL=https://api.roof-er-training.com
REACT_APP_ENABLE_MOCK_API=false

# Agnes AI Production Configuration
REACT_APP_AGNES_DEBUG_MODE=false
REACT_APP_ENABLE_TRAINING_LOGS=false

# Feature Flags for Production
REACT_APP_ENABLE_EXPERIMENTAL_FEATURES=false
REACT_APP_ENABLE_A11Y_DEBUG=false

# Analytics and Monitoring
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_SENTRY_DSN=your_sentry_dsn_here