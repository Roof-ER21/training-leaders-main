# Video Generation Service Environment Variables

# Groq API Key (for Agnes script generation)
GROQ_API_KEY=your_groq_api_key_here

# D-ID API Key (for video generation)
# Sign up at: https://www.d-id.com/
# Free tier: 20 videos/month
# Creator tier: $49/month unlimited
DID_API_KEY=your_did_api_key_here

# Server Port
PORT=3003
